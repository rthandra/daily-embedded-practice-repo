/*

optimized - track max val from left and right

intialize maxleft, maxright, result arr, index k
set maxleft as first index, maxright as last index

add first element
loop until nums - 1:

    check if current index is greater than max left:
        add index to result arr
        update max left
    else:
        check if current index greater than max right:
            add index to result arr - u cant do this for max right cause iterating from left to right so max left is easier to compute

for max right:
    precompute maxright for every index and store it in a seperate function

add last element - O(n) time , O(n + n) = O(n) space
*/


int* findValidElements(int* nums, int numsSize, int* returnSize) {
    int *resArr = malloc(numsSize * sizeof(int));
    int k = 1;
    int maxLeft = nums[0]; //1
    resArr[0] = nums[0]; //[1]
    //[1,2,4,2,3,2]
    int *maxRight_Arr = malloc(numsSize * sizeof(int));
        int maxRight = nums[numsSize - 1]; //2
        maxRight_Arr[numsSize - 1] = -1;  //[-1]
        maxRight_Arr[0] = -1;

        for(int i = numsSize - 2; i > 0; i--){
            maxRight_Arr[i] = maxRight;  //[-1, 4, 3, 3, 2,-1]

            if(nums[i] > maxRight){
                maxRight = nums[i]; //4
            }
        }

    for(int i = 1; i < numsSize - 1; i++){
        if(nums[i] > maxLeft){ 
            resArr[k++] = nums[i]; 
            maxLeft = nums[i]; //4
        }
        else{ //dont know how i would calculate max right
            if(nums[i] > maxRight_Arr[i]){
                resArr[k++] = nums[i]; //[1,2,4,3]
            }
        }
    }

    if(numsSize > 1){
        resArr[k++] = nums[numsSize-1];
    }
    *returnSize = k;
    return resArr;
}




