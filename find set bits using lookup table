#include <stdio.h>
#include <stdint.h>

int lookup(int n){

  static int arr[255];
  arr[0] = 0;

  for(int i = 1; i < 255; i++){
    arr[i] = arr[i >> 1] + (i & 1); //4 =
  }

  for(int j = 0; j < 255; j++){
    if(n == j){
      return arr[j];
    }
  }
  return 0;

}

int main(){

  int count = lookup(7);
  printf("%d", count);
  return 0;
}
