/*time complexity: o(log(pow))
recursion is a loop so not o(1)
every time its halved when its even so o(long(x))
u loop pow times so o(log(pow))
*/
int power(int n, int pow){ //2,2

  if(pow == 0){
    return 1; //3. returns 1 to 2
  }

  if((pow % 2) == 0){
    int half =  power(n, pow/2); // 1. n * (2, 1) -> 2 * 2 = 4
    return half * half; //n ^ 4 = n ^ 2 * n^2
  }
  else{
    return n * power(n, pow-1); //2.  n * (2, 0), 2 * 1 = 2 will return 2 to step 1
  }
   
}
int main(){
 int res =  power(3, 4);
 printf("%d", res);
}
