/*

array of pointers 

* - flower
* - flow
* - flight

check if all the powers are pointing to same char
if yes add it to output string
move pointers - repeat until one of them is end of array

edge case: if string is empty

time complexity - outer loop - 0(n) where n is length of each string
                - inner loop - 0(m) where m is the number of strings
                so O(n * m)

space complexity - output string has length of n where n is length of each string so O(n)

*/

char* longestCommonPrefix(char** strs, int strsSize) {

    int len = strlen(strs[0]);
    char *output = malloc(len + 1); //if len = 0, you need to still allocate 1 byte for '\0'
    int k = 0;
    
    for(int j = 0; j < len; j++){
        for (int i = 1; i < strsSize; i++){
            if(strs[i][j] != strs[0][j]){
                output[k] = '\0';
                return output;
            }
        }
        output[k++] = strs[0][j];
    }
    output[k] = '\0';
    return output;
    
}
