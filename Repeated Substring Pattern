
/*

bruteforce: 0(n ^ 2) - time complexity

1. build my prefix
prefix var
loop until string:
    prefix = first char, extend to send char until end
    loop until end of string:
       if check if a exits throught the array:
        break
    return true

return false

edge cases: ababcd - need to make sure to check prefix for the entire string, don't return true earlier
*/

bool repeatedSubstringPattern(char* s) {
    int len = strlen(s); 
    char prefix[len]; 
    int k = 0;
    int i = 0;

    while(k < len/2){ //prefix is always half of len or less - n
        int flag = 0;
        prefix[k++] = s[i++];
        for(int j = k; j < len; j += k){ 
            if(strncmp(s + j, prefix, k) != 0){ 
               flag = 1;
               break;
            }
        }
        if(flag == 0){
            return true;
        }
    }
    return false;
}
