Given a string s consisting of words and spaces, return the length of the last word in the string.

/*

edge cases:
1. if only char
intialize count, flag pointer to end

*/
//"   fly me   to   the moon  "
int lengthOfLastWord(char* s) {

    int count = 0;
    int right = strlen(s)-1;

    while(right >= 0){
        while(right >= 0 && s[right] != ' '){
            right--;
            count++;
        }        
        if(count > 0){
            return count;
        }
        right --;
    }
    return count;
} 

//refactored code:

int lengthOfLastWord(char* s) {
    int right = strlen(s) - 1;
    int count = 0;

    while(right >= 0 && s[right] == ' '){
        right--;
    }

    while(right >= 0 && s[right] != ' '){
        right--;
        count++;
    }
    return count;
}
