/*optimized way:

intuition:

 - shaunak wins if sum is odd
 - if sum isnt odd:
      he can use the special move
      after using the special move (n * k):
        if sum is even:
          shaunak wins
        if sum is odd:
          shaunak looses
*/


int main(){

  int arr[3] = {1,2,3};
  int k = 3;
  int sum = 0;
  int n = 3;

  for(int i = 0; i < n; i++){
    sum += arr[i];
  }

  if((sum % 2 == 1) || (k * n) % 2 == 0){
    printf("shaumak wins");
  }
  else{
    printf("yash wins");
  }
  return 0;
}
